# Ubion LiteLLM 프록시. 앱 워크스페이스 설정(data/user_settings.json)이 우선한다.
# 여기에 채워두면 앱 첫 실행 시 기본값으로 미리 들어간다(팀 배포 시 편리).
UBION_LITELLM_URL=http://192.168.50.119:4000
UBION_LITELLM_KEY=
# 기본 모델 (deepseek-v4-flash-think | claude-sonnet-4-6 | claude-opus-4-7 | ...)
UBION_LITELLM_MODEL=deepseek-v4-flash-think

# 슬라이드 사진(선택). 넣으면 Unsplash 우선, 비우면 Openverse 만 사용.
# Openverse 만 쓰면 검색어에 따라 사진이 없는 슬라이드가 생긴다(적중률 약 60%).
UNSPLASH_ACCESS_KEY=

# 서버 포트
IDA_PORT=8701

# ── 산출물 위치 (선택) ──────────────────────────────────────────────────────
# 주차별 산출물(교재·개요·플랜·사진·덱)을 저장소 밖에 두려면 절대경로를 지정한다.
# 비우면 저장소 안의 workspace/ 를 쓴다. 어느 쪽이든 커밋에는 포함되지 않는다.
#   예) IDA_WORKSPACE=D:\00work\_산출물\교수설계
IDA_WORKSPACE=
# 강좌 목록·강의 정보 DB 경로(선택). 비우면 data/app.db.
IDA_DB_PATH=
