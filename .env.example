# ── LLM 연결 ────────────────────────────────────────────────
# 기본은 Claude Code CLI (구독 인증). 키·URL 이 필요 없다.
IDA_PROVIDER=cli
# CLI 실행 파일을 못 찾을 때만 지정 (보통 자동 탐색된다)
# CLAUDE_CLI=

# 사내 LiteLLM 프록시를 쓸 때만 (IDA_PROVIDER=litellm)
UBION_LITELLM_URL=http://192.168.50.119:4000
UBION_LITELLM_KEY=

# ── 산출물 폴더 ─────────────────────────────────────────────
# 저장소 밖에 둔다. 영상 한 편이 수십 MB 라 안에 두면 git 이 못 버틴다.
# 비우면 저장소 안의 workspace/ 를 쓴다(권장하지 않음).
IDA_WORKSPACE=D:\00work\lecture-out

# ── 영상 엔진 ───────────────────────────────────────────────
# 비우면 이 저장소 자신을 쓴다(엔진이 vendor/chodangi 에 같이 들어 있다).
# 엔진만 따로 떼어 둔 경우에만 그 폴더를 지정한다.
# VIDEO_ENGINE=

# ── 선택 ────────────────────────────────────────────────────
# 슬라이드 사진. 넣으면 Unsplash 우선, 비우면 Openverse 만 쓴다(적중률 약 60%).
# UNSPLASH_ACCESS_KEY=
# 강좌·주차 DB 경로. 비우면 data/app.db.
# IDA_DB_PATH=
IDA_PORT=8701
