# ── 가상환경 ────────────────────────────────────────────────
.venv/
.venv-app/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# ── 용량 큰 자산 (별도 배포) ─────────────────────────────────
# Supertonic 3 음성 모델 383MB
vendor/chodangi/assets/
# 슬라이드 폰트(Pretendard OFL) — setup 시 내려받는다
assets/fonts/
static/fonts/

# ── 런타임 · 로컬 작업물 ────────────────────────────────────
.env
data/user_settings.json
data/app.db
data/app.db-wal
data/app.db-shm
data/lectures.json
# 엔진 스크래치(CLI 로 직접 돌릴 때). 앱 산출물은 IDA_WORKSPACE 로 저장소 밖에 나간다
.engine-work/
uploads/
*.tmp.*

# ── 사내 자료 · 원본 (커밋 금지) ────────────────────────────
